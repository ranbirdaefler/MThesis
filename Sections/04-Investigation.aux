\@writefile{lot}{\contentsline {table}{\numberline {4.12}{\ignorespaces \textbf  {A training-only per-drug lookup is the bar to beat.} Reference, model and drug-agnostic arms use all $\num {1394}$ conditions; the drug lookups exist on a common support of $\num {1192}$, where model and reference score $0.549$ and $0.857$. There, model minus \texttt  {drug\_lookup} is $-0.3631$\,\allowbreak  \mbox  {\textcolor {quietink}{[}$-0.3982$\textcolor {quietink}{,}}\penalty 700 \hspace  {0.25em plus 0.08em minus 0.04em}\mbox  {$-0.3280$\textcolor {quietink}{]}}; the lookup scores $0.913$ pooled, $0.980$ on trained conditions and $0.890$ on held-out wells, where its same-well advantage is absent. \texttt  {moa\_lookup} has narrower support ($n = \num {218}$) and is not separated from the model ($+0.0436$\,\allowbreak  \mbox  {\textcolor {quietink}{[}$-0.0480$\textcolor {quietink}{,}}\penalty 700 \hspace  {0.25em plus 0.08em minus 0.04em}\mbox  {$+0.1352$\textcolor {quietink}{]}}); its pooled row must not be compared with rows on other supports.}}{110}{table.caption.176}\protected@file@percent }
\newlabel{tab:lookup}{{4.12}{110}{\textbf {A training-only per-drug lookup is the bar to beat.} Reference, model and drug-agnostic arms use all $\num {1394}$ conditions; the drug lookups exist on a common support of $\num {1192}$, where model and reference score $0.549$ and $0.857$. There, model minus \texttt {drug\_lookup} is \ci {-0.3631}{-0.3982}{-0.3280}; the lookup scores $0.913$ pooled, $0.980$ on trained conditions and $0.890$ on held-out wells, where its same-well advantage is absent. \texttt {moa\_lookup} has narrower support ($n = \num {218}$) and is not separated from the model (\ci {+0.0436}{-0.0480}{+0.1352}); its pooled row must not be compared with rows on other supports}{table.caption.176}{}}
\newlabel{tab:lookup@cref}{{[table][12][4]4.12}{[1][108][]110}{}{}{}}

% [OK] Verified from the PDF. THE BACKBONE OF THIS THESIS. Proceedings of the
% 41st ICML (2024); preprint bioRxiv 2023.09.11.557287, v4 posted 29 Oct 2024.
% Code: github.com/vandijklab/cell2sentence
% Key technical claim we build on AND complicate: expression is recoverable
% from rank via a fitted log-linear model e_i = a_d*log(r_i) + b_d, with
% R^2 = 0.815 on PBMC -- i.e. cell sentences preserve expression. Our finding
% is that expression rank is nonetheless the wrong thing to preserve for DRUG
% discrimination, since 83% of the ranked tokens are shared across drugs.
@inproceedings{c2s,
  title     = {Cell2Sentence: Teaching Large Language Models the Language of Biology},
  author    = {Levine, Daniel and Rizvi, Syed Asad and L{\'e}vy, Sacha and Pallikkavaliyaveetil, Nazreen and Zhang, David and Chen, Xingyu and Ghadermarzi, Sina and Wu, Ruiming and Zheng, Zihe and Vrkic, Ivan and Zhong, Anna and Raskin, Daphne and Han, Insu and de Oliveira Fonseca, Antonio Henrique and Ortega Caro, Josue and Karbasi, Amin and Dhodapkar, Rahul M. and van Dijk, David},
  booktitle = {Proceedings of the 41st International Conference on Machine Learning (ICML)},
  year      = {2024},
  note      = {Preprint: bioRxiv 2023.09.11.557287}
}


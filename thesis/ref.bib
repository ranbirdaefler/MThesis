% [OK] Verified from the PDF. THE PROPONENT side of the dispute. Introduces the
% interpolated duplicate (positive control) and the Dynamic Range Fraction
% (DRF). 14 Perturb-seq datasets, 13 metrics, 8 deep learning models. Finds
% MSE and Pearson(delta_ctrl) poorly calibrated; WMSE, weighted R2 delta and
% NIR consistently calibrated; and that under calibrated metrics deep models
% DO beat mean/control/linear baselines. Scope: GENETIC perturbation.
% This thesis ports their DRF framework and reaches the opposite conclusion on
% DRUG perturbation -- using their own instrument.
@article{miller,
  title   = {Deep Learning-Based Genetic Perturbation Models Do Outperform Uninformative Baselines on Well-Calibrated Metrics},
  author  = {Miller, Henry E. and Mejia, Gabriel M. and Leblanc, Francis J. A. and Wang, Bo and Swain, Brendan and de Lima Camillo, Lucas Paulo},
  journal = {bioRxiv},
  year    = {2025},
  doi     = {10.1101/2025.10.20.683304},
  note    = {Preprint, posted 21 October 2025. Shift Bioscience Ltd.}
}


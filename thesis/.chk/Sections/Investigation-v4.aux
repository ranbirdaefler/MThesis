\@writefile{toc}{\contentsline {subsection}{\numberline {3.11}Sensitivity is not fidelity}{47}{subsection.3.11}\protected@file@percent }
\newlabel{sec:methods-holdout}{{3.11}{47}{Sensitivity is not fidelity}{subsection.3.11}{}}
\newlabel{sec:res-generalisation}{{3.11}{47}{Sensitivity is not fidelity}{subsection.3.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces Whole-well holdout on the rebuilt targets (split-before-fit, plate-scoped generic). Only the \texttt  {orth} column can carry a magnitude claim; the \texttt  {opposite} column adds ``how much naming a lie hurts'' to ``how much naming the truth helps'' and is shown as the diagnostic. The \texttt  {unseen\_drug} row corroborates rather than proves: those drugs were held out of fine-tuning, so a large gap there would indict the comparator --- but ``unseen'' means unseen during fine-tuning, not during pretraining, and the prompt still supplies a mechanism, so a strictly zero effect was never guaranteed. Its \texttt  {opposite} gap is nine times its neutral one and only just contains zero. What establishes comparator non-neutrality is the direct $0.572/0.497/0.403$ ordering above. Model $\textrm  {NIR}$ intervals test against the chance value $0.5$ with no comparator. Intervals are two-way cluster-robust over cell lines and wells, with a Student $t$ reference on $\min (G_{\textrm  {line}}, G_{\textrm  {well}}) - 1$ degrees of freedom --- which is why the well counts are printed: the \texttt  {unseen\_drug} arm spans $25$ wells, and $t_{24} = 2.06$ against $1.96$ widens its interval by five per cent (\S  \ref {sec:methods-data}).}}{49}{table.caption.26}\protected@file@percent }
\newlabel{tab:generalisation}{{13}{49}{Whole-well holdout on the rebuilt targets (split-before-fit, plate-scoped generic). Only the \texttt {orth} column can carry a magnitude claim; the \texttt {opposite} column adds ``how much naming a lie hurts'' to ``how much naming the truth helps'' and is shown as the diagnostic. The \texttt {unseen\_drug} row corroborates rather than proves: those drugs were held out of fine-tuning, so a large gap there would indict the comparator --- but ``unseen'' means unseen during fine-tuning, not during pretraining, and the prompt still supplies a mechanism, so a strictly zero effect was never guaranteed. Its \texttt {opposite} gap is nine times its neutral one and only just contains zero. What establishes comparator non-neutrality is the direct $0.572/0.497/0.403$ ordering above. Model $\NIR $ intervals test against the chance value $0.5$ with no comparator. Intervals are two-way cluster-robust over cell lines and wells, with a Student $t$ reference on $\min (G_{\textrm {line}}, G_{\textrm {well}}) - 1$ degrees of freedom --- which is why the well counts are printed: the \texttt {unseen\_drug} arm spans $25$ wells, and $t_{24} = 2.06$ against $1.96$ widens its interval by five per cent (\S \ref {sec:methods-data})}{table.caption.26}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.12}A lookup table wins}{51}{subsection.3.12}\protected@file@percent }
\newlabel{sec:methods-baselines}{{3.12}{51}{A lookup table wins}{subsection.3.12}{}}
\newlabel{sec:res-lookup}{{3.12}{51}{A lookup table wins}{subsection.3.12}{}}
\@writefile{lot}{\contentsline {table}{\numberline {14}{\ignorespaces The baseline ladder on the rebuilt targets, $n = 570$ scored conditions; the lookups are fitted from training conditions only. Ceiling and model rows by split: $0.962$/$0.955$/$0.956$ and $0.635$/$0.545$/$0.512$ (train / unseen-combination / unseen-drug). \texttt  {drug\_lookup} is the pre-registered win condition: a lookup can reproduce a memorised average, so only a model that tailors the response to the control cell's state can beat it. \texttt  {moa\_lookup} is scored on the $118$ conditions that have a training-drug MoA partner, so that row does not sit on the $n = 570$ support the rest of the ladder does. The paired comparison on the common support ($n = 449$) is model $-$ \texttt  {drug\_lookup} $= $-0.3559$ \,[$-0.3988$, $-0.3130$]$, and of the distance from chance to the replicate ceiling the model covers $18.6\%$ against the lookup's $96.3\%$.}}{52}{table.caption.27}\protected@file@percent }
\newlabel{tab:baselines}{{14}{52}{The baseline ladder on the rebuilt targets, $n = 570$ scored conditions; the lookups are fitted from training conditions only. Ceiling and model rows by split: $0.962$/$0.955$/$0.956$ and $0.635$/$0.545$/$0.512$ (train / unseen-combination / unseen-drug). \texttt {drug\_lookup} is the pre-registered win condition: a lookup can reproduce a memorised average, so only a model that tailors the response to the control cell's state can beat it. \texttt {moa\_lookup} is scored on the $118$ conditions that have a training-drug MoA partner, so that row does not sit on the $n = 570$ support the rest of the ladder does. The paired comparison on the common support ($n = 449$) is model $-$ \texttt {drug\_lookup} $= \ci {-0.3559}{-0.3988}{-0.3130}$, and of the distance from chance to the replicate ceiling the model covers $18.6\%$ against the lookup's $96.3\%$}{table.caption.27}{}}
\newlabel{tab:lookup}{{14}{52}{The baseline ladder on the rebuilt targets, $n = 570$ scored conditions; the lookups are fitted from training conditions only. Ceiling and model rows by split: $0.962$/$0.955$/$0.956$ and $0.635$/$0.545$/$0.512$ (train / unseen-combination / unseen-drug). \texttt {drug\_lookup} is the pre-registered win condition: a lookup can reproduce a memorised average, so only a model that tailors the response to the control cell's state can beat it. \texttt {moa\_lookup} is scored on the $118$ conditions that have a training-drug MoA partner, so that row does not sit on the $n = 570$ support the rest of the ladder does. The paired comparison on the common support ($n = 449$) is model $-$ \texttt {drug\_lookup} $= \ci {-0.3559}{-0.3988}{-0.3130}$, and of the distance from chance to the replicate ceiling the model covers $18.6\%$ against the lookup's $96.3\%$}{table.caption.27}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.13}What is closed and open for unseen drugs}{53}{subsection.3.13}\protected@file@percent }
\newlabel{sec:res-scope}{{3.13}{53}{What is closed and open for unseen drugs}{subsection.3.13}{}}
\@writefile{lot}{\contentsline {table}{\numberline {15}{\ignorespaces Coverage is stated first: a channel annotated on few drugs cannot be closed by a null result, because it was never tested. The plate-matched null is the estimand-correct control; the count-matched column shows how much of each raw gap was co-plating. Chemistry reproduces the structure-only test in this frame; both knowledge channels clear their corrected nulls.}}{53}{table.caption.28}\protected@file@percent }
\newlabel{tab:channels}{{15}{53}{Coverage is stated first: a channel annotated on few drugs cannot be closed by a null result, because it was never tested. The plate-matched null is the estimand-correct control; the count-matched column shows how much of each raw gap was co-plating. Chemistry reproduces the structure-only test in this frame; both knowledge channels clear their corrected nulls}{table.caption.28}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.14}Which part of the prompt is read remains unresolved}{55}{subsection.3.14}\protected@file@percent }
\newlabel{sec:res-field}{{3.14}{55}{Which part of the prompt is read remains unresolved}{subsection.3.14}{}}
\@writefile{lot}{\contentsline {table}{\numberline {16}{\ignorespaces Availability and use are different questions, and only the first is currently answered. Panel A shows that a drug's protein targets and mechanism carry response information recoverable by retrieval alone, so an unseen drug is not information-starved. Panel B asks whether the model uses the field it is already handed, and is deliberately empty: the arms exist and are implemented, but the only run that scored them used the \texttt  {opposite}-signature comparator that \S  \ref {sec:res-generalisation} shows inflates every gap read against it. Panel B is measured against the neutral comparator in the corrected evaluation. The mechanism row will carry fewer conditions than the others by construction, for the reason given above.}}{56}{table.caption.29}\protected@file@percent }
\newlabel{tab:fieldattribution}{{16}{56}{Availability and use are different questions, and only the first is currently answered. Panel A shows that a drug's protein targets and mechanism carry response information recoverable by retrieval alone, so an unseen drug is not information-starved. Panel B asks whether the model uses the field it is already handed, and is deliberately empty: the arms exist and are implemented, but the only run that scored them used the \texttt {opposite}-signature comparator that \S \ref {sec:res-generalisation} shows inflates every gap read against it. Panel B is measured against the neutral comparator in the corrected evaluation. The mechanism row will carry fewer conditions than the others by construction, for the reason given above}{table.caption.29}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.15}The investigation in one table}{56}{subsection.3.15}\protected@file@percent }
